








# Pandas → used for working with tabular data
import pandas as pd

# NumPy → used for numerical operations
import numpy as np

# Matplotlib → used for creating graphs
import matplotlib.pyplot as plt

# Seaborn → used for statistical visualizations
import seaborn as sns


# Load the loan dataset from the data folder
df = pd.read_csv("../data/Loan.csv")


# Display the first 5 rows of the dataset
df.head()


# Display the last 5 rows of the dataset
df.tail()


# Display the number of rows and columns
df.shape


# Display all column names in the dataset
df.columns


# Display information about the dataset
df.info()



# Count missing values in each column
df.isnull().sum()


# Count duplicate rows in the dataset
df.duplicated().sum()


# Display statistical information for numerical columns
df.describe()


# Count the number of approved and rejected loans
df["LoanApproved"].value_counts()


# Count the number of approved and rejected loans
sns.countplot(x="LoanApproved", data=df)

# Add a title to the graph
plt.title("Loan Approval Distribution")

# Display the graph
plt.show()











# Display the distribution of applicant ages
sns.histplot(data=df, x="Age", bins=20)

# Add a title
plt.title("Distribution of Applicant Age")

# Display the graph
plt.show()





# Display the distribution of annual income
sns.histplot(data=df, x="AnnualIncome", bins=30)

# Add a title
plt.title("Distribution of Annual Income")

# Display the graph
plt.show()





# Display the distribution of credit scores
sns.histplot(data=df, x="CreditScore", bins=20)

# Add a title
plt.title("Distribution of Credit Score")

# Display the graph
plt.show()





# Display the distribution of loan amounts
sns.histplot(data=df, x="LoanAmount", bins=30)

# Add a title
plt.title("Distribution of Loan Amount")

# Display the graph
plt.show()





# Display the distribution of debt-to-income ratio
sns.histplot(data=df, x="DebtToIncomeRatio", bins=20)

# Add a title
plt.title("Distribution of Debt-to-Income Ratio")

# Display the graph
plt.show()





# Compare credit scores for approved and rejected loans
sns.boxplot(data=df, x="LoanApproved", y="CreditScore")

# Add a title
plt.title("Credit Score vs Loan Approval")

# Label the x-axis
plt.xlabel("Loan Approved (0 = No, 1 = Yes)")

# Display the graph
plt.show()





# Compare annual income for approved and rejected loans
sns.boxplot(data=df, x="LoanApproved", y="AnnualIncome")

# Add a title
plt.title("Annual Income vs Loan Approval")

# Label the x-axis
plt.xlabel("Loan Approved (0 = No, 1 = Yes)")

# Display the graph
plt.show()





# Compare loan amounts for approved and rejected loans
sns.boxplot(data=df, x="LoanApproved", y="LoanAmount")

# Add a title
plt.title("Loan Amount vs Loan Approval")

# Label the x-axis
plt.xlabel("Loan Approved (0 = No, 1 = Yes)")

# Display the graph
plt.show()





# Compare debt-to-income ratios for approved and rejected loans
sns.boxplot(data=df, x="LoanApproved", y="DebtToIncomeRatio")

# Add a title
plt.title("Debt-to-Income Ratio vs Loan Approval")

# Label the x-axis
plt.xlabel("Loan Approved (0 = No, 1 = Yes)")

# Display the graph
plt.show()








# Compare employment status with loan approval
sns.countplot(data=df, x="EmploymentStatus", hue="LoanApproved")

# Add a title
plt.title("Employment Status vs Loan Approval")

# Display the graph
plt.show()





# Calculate the average approval rate for each employment category
approval_rate = df.groupby("EmploymentStatus")["LoanApproved"].mean()

# Display the approval rate
approval_rate


# Plot the approval rate for each employment category
approval_rate.plot(kind="bar")

# Add a title
plt.title("Loan Approval Rate by Employment Status")

# Label the axes
plt.xlabel("Employment Status")
plt.ylabel("Approval Rate")

# Display the graph
plt.show()





# Calculate approval rate for each education level
education_rate = df.groupby("EducationLevel")["LoanApproved"].mean()

# Display the approval rates
education_rate


# Plot the approval rate for each education level
education_rate.plot(kind="bar")

# Add a title
plt.title("Loan Approval Rate by Education Level")

# Label the axes
plt.xlabel("Education Level")
plt.ylabel("Approval Rate")

# Display the graph
plt.show()





# Calculate approval rate for each marital status
marital_rate = df.groupby("MaritalStatus")["LoanApproved"].mean()

# Display the approval rates
marital_rate


# Plot the approval rate for each marital status
marital_rate.plot(kind="bar")

# Add a title
plt.title("Loan Approval Rate by Marital Status")

# Label the axes
plt.xlabel("Marital Status")
plt.ylabel("Approval Rate")

# Display the graph
plt.show()





# Calculate approval rate for each number of dependents
dependents_rate = df.groupby("NumberOfDependents")["LoanApproved"].mean()

# Display the approval rates
dependents_rate


# Plot the approval rate for each number of dependents
dependents_rate.plot(kind="bar")

# Add a title
plt.title("Loan Approval Rate by Number of Dependents")

# Label the axes
plt.xlabel("Number of Dependents")
plt.ylabel("Approval Rate")

# Display the graph
plt.show()


# Calculate approval rate for each home ownership category
home_rate = df.groupby("HomeOwnershipStatus")["LoanApproved"].mean()

# Display the approval rates
home_rate


# Plot the approval rate for each home ownership category
home_rate.plot(kind="bar")

# Add a title
plt.title("Loan Approval Rate by Home Ownership")

# Label the axes
