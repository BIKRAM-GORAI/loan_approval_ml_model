# Pandas → used for working with tabular data
import pandas as pd

# NumPy → used for numerical operations
import numpy as np

# Matplotlib → used for creating graphs
import matplotlib.pyplot as plt

# Seaborn → used for statistical visualizations
import seaborn as sns


# Load the loan dataset from the data folder
df = pd.read_csv("../data/Loan.csv")


# Display the first 5 rows of the dataset
df.head()


# Display the last 5 rows of the dataset
df.tail()


# Display the number of rows and columns
df.shape


# Display all column names in the dataset
df.columns


# Display information about the dataset
df.info()



# Count missing values in each column
df.isnull().sum()


# Count duplicate rows in the dataset
df.duplicated().sum()


# Display statistical information for numerical columns
df.describe()


# Count the number of approved and rejected loans
df["LoanApproved"].value_counts()


# Count the number of approved and rejected loans
sns.countplot(x="LoanApproved", data=df)

# Add a title to the graph
plt.title("Loan Approval Distribution")

# Display the graph
plt.show()











# Display the distribution of applicant ages
sns.histplot(data=df, x="Age", bins=20)

# Add a title
plt.title("Distribution of Applicant Age")

# Display the graph
plt.show()





# Display the distribution of annual income
sns.histplot(data=df, x="AnnualIncome", bins=30)

# Add a title
plt.title("Distribution of Annual Income")

# Display the graph
plt.show()





# Display the distribution of credit scores
sns.histplot(data=df, x="CreditScore", bins=20)

# Add a title
plt.title("Distribution of Credit Score")

# Display the graph
plt.show()





# Display the distribution of loan amounts
sns.histplot(data=df, x="LoanAmount", bins=30)

# Add a title
plt.title("Distribution of Loan Amount")

# Display the graph
plt.show()





# Display the distribution of debt-to-income ratio
sns.histplot(data=df, x="DebtToIncomeRatio", bins=20)

# Add a title
plt.title("Distribution of Debt-to-Income Ratio")

# Display the graph
plt.show()





# Compare credit scores for approved and rejected loans
sns.boxplot(data=df, x="LoanApproved", y="CreditScore")

# Add a title
plt.title("Credit Score vs Loan Approval")

# Label the x-axis
plt.xlabel("Loan Approved (0 = No, 1 = Yes)")

# Display the graph
plt.show()



